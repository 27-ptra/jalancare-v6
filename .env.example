# JalanCare V6 Environment Example

# Flask
SECRET_KEY=ganti_dengan_random_secret_key_yang_panjang

# Database
# Kosongkan DATABASE_URL jika ingin pakai SQLite lokal.
# Isi dengan connection string Supabase PostgreSQL jika deploy online.
# Contoh format umum:
# DATABASE_URL=postgresql://postgres.xxxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Admin default pertama
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_DEFAULT_EMAIL=admin@jalancare.local

# YOLO model
MODEL_PATH=best.pt

# Folder lokal
UPLOAD_FOLDER=static/uploads
RESULT_FOLDER=static/results
REPAIR_FOLDER=static/repairs
PDF_FOLDER=static/pdf

# Supabase Storage - opsional
# Isi hanya jika ingin upload gambar ke Supabase Storage.
USE_SUPABASE_STORAGE=false
SUPABASE_URL=https://project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key_supabase
SUPABASE_STORAGE_BUCKET=jalancare
